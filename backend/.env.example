NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/reconresolve_dev

# Redis Cache & Distributed Rate Limiting (Optional; defaults to in-memory store if unset)
REDIS_URL=redis://localhost:6379

# PayPal Sandbox credentials (never commit actual values)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_DURATION_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=60000
OUTBOX_DRAIN_TIMEOUT_MS=10000

# Session & Authentication Configuration (Optional override; defaults to 168h / 7 days)
SESSION_TTL_HOURS=168

# AI Model Provider Configuration (Google Gemini)
# Obtain key from Google AI Studio (never commit actual values)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Optional Opt-in Live Smoke Test (disabled by default)
# When set to true with a valid GEMINI_API_KEY, runs the live provider integration test
LIVE_AI_TEST=false