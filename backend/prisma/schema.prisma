generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MerchantStatus {
  ACTIVE
  SUSPENDED
}

enum Provider {
  PAYPAL
}

enum ProviderConnectionStatus {
  ACTIVE
  DISABLED
  NEEDS_REAUTH
}

enum TransactionStatus {
  CREATED
  APPROVED
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum ProviderTransactionType {
  PAYMENT
  CAPTURE
  REFUND
  REVERSAL
  ADJUSTMENT
  OTHER
}

enum MerchantOrderStatus {
  OPEN
  PAYMENT_PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum ReconciliationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ExceptionType {
  MISSING_PROVIDER_COUNTERPART
  MISSING_MERCHANT_COUNTERPART
  AMOUNT_MISMATCH
  STATUS_DISCREPANCY
  AMBIGUOUS_MATCH
}

enum ExceptionStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Merchant

model Merchant {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  slug      String         @unique
  status    MerchantStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  providerConnections  ProviderConnection[]
  merchantOrders       MerchantOrder[]
  providerTransactions ProviderTransaction[]
  reconciliationRuns   ReconciliationRun[]
  exceptions           ReconciliationException[]

  @@map("merchants")
}

// ---------------------------------------------------------------------------
// ProviderConnection

model ProviderConnection {
  id                String                   @id @default(uuid()) @db.Uuid
  merchantId        String                   @map("merchant_id") @db.Uuid
  provider          Provider
  connectionKey     String                   @map("connection_key")
  providerAccountId String?                  @map("provider_account_id")
  status            ProviderConnectionStatus @default(DISABLED)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  // Relations
  merchant             Merchant              @relation(fields: [merchantId], references: [id])
  providerTransactions ProviderTransaction[]

  @@unique([merchantId, provider, connectionKey])
  @@index([merchantId, provider])
  @@map("provider_connections")
}

// ---------------------------------------------------------------------------
// ProviderTransaction

model ProviderTransaction {
  id                   String                  @id @default(uuid()) @db.Uuid
  merchantId           String                  @map("merchant_id") @db.Uuid
  providerConnectionId String                  @map("provider_connection_id") @db.Uuid
  providerTxnId        String                  @map("provider_txn_id")
  providerOrderId      String?                 @map("provider_order_id")
  type                 ProviderTransactionType
  status               TransactionStatus
  amountMinor          BigInt                  @map("amount_minor")
  currency             String                  @map("currency") @db.Char(3)
  feeMinor             BigInt?                 @map("fee_minor")
  occurredAt           DateTime                @map("occurred_at")
  rawPayload           Json                    @map("raw_payload")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  // Relations
  merchant           Merchant                  @relation(fields: [merchantId], references: [id])
  providerConnection ProviderConnection        @relation(fields: [providerConnectionId], references: [id])
  exceptions         ReconciliationException[]

  @@unique([providerConnectionId, providerTxnId])
  @@index([merchantId, occurredAt])
  @@index([merchantId, providerOrderId])
  @@map("provider_transactions")
}

// ---------------------------------------------------------------------------
// MerchantOrder

model MerchantOrder {
  id              String              @id @default(uuid()) @db.Uuid
  merchantId      String              @map("merchant_id") @db.Uuid
  externalOrderId String              @map("external_order_id")
  amountMinor     BigInt              @map("amount_minor")
  currency        String              @map("currency") @db.Char(3)
  status          MerchantOrderStatus
  orderedAt       DateTime            @map("ordered_at")
  metadata        Json?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  merchant   Merchant                  @relation(fields: [merchantId], references: [id])
  exceptions ReconciliationException[]

  @@unique([merchantId, externalOrderId])
  @@index([merchantId, orderedAt])
  @@map("merchant_orders")
}

// ---------------------------------------------------------------------------
// ReconciliationRun

model ReconciliationRun {
  id          String                  @id @default(uuid()) @db.Uuid
  merchantId  String                  @map("merchant_id") @db.Uuid
  status      ReconciliationRunStatus @default(PENDING)
  windowStart DateTime                @map("window_start")
  windowEnd   DateTime                @map("window_end")
  startedAt   DateTime?               @map("started_at")
  completedAt DateTime?               @map("completed_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  // Relations
  merchant   Merchant                  @relation(fields: [merchantId], references: [id])
  exceptions ReconciliationException[]

  @@index([merchantId, createdAt])
  @@index([merchantId, status])
  @@map("reconciliation_runs")
}

// ---------------------------------------------------------------------------
// ReconciliationException

model ReconciliationException {
  id                    String          @id @default(uuid()) @db.Uuid
  merchantId            String          @map("merchant_id") @db.Uuid
  reconciliationRunId   String?         @map("reconciliation_run_id") @db.Uuid
  type                  ExceptionType
  status                ExceptionStatus @default(OPEN)
  providerTransactionId String?         @map("provider_transaction_id") @db.Uuid
  merchantOrderId       String?         @map("merchant_order_id") @db.Uuid
  details               Json?
  resolutionNote        String?         @map("resolution_note")
  resolvedAt            DateTime?       @map("resolved_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  // Relations
  merchant            Merchant             @relation(fields: [merchantId], references: [id])
  reconciliationRun   ReconciliationRun?   @relation(fields: [reconciliationRunId], references: [id])
  providerTransaction ProviderTransaction? @relation(fields: [providerTransactionId], references: [id])
  merchantOrder       MerchantOrder?       @relation(fields: [merchantOrderId], references: [id])

  @@index([merchantId, status, createdAt])
  @@index([merchantId, reconciliationRunId])
  @@map("reconciliation_exceptions")
}
