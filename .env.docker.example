# ==============================================================================
# FlowOps Docker Environment Configuration Template
# Copy this file to .env before running `docker-compose up`:
#   cp .env.docker.example .env
# ==============================================================================

NODE_ENV=development
ALLOW_TEST_FAKE_AI=true

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reconresolve
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@db:5432/reconresolve?schema=public

# Service Ports (Exposed on Host)
API_PORT=3001
FRONTEND_PORT=5173

# Security & Sessions
SESSION_TTL_HOURS=168
CORS_ALLOWED_ORIGIN=*

# Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_DURATION_MS=30000
OUTBOX_CONCURRENCY=5
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=60000
OUTBOX_DRAIN_TIMEOUT_MS=10000

# Optional External Provider Credentials (leave blank to run in isolated/mock mode)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

